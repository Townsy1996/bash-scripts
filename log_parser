#!/bin/bash

if [ -z "$1" ]; then
    echo "Error: Requires log file ./log_parser <logfile>" >&2
    exit 1
fi

if [ ! -f "$1" ]; then
    echo "Error: The input file does not exist, please choose existing file" >&2
    exit 1
fi

for level in ERROR WARN INFO; do
    count="$(grep -c "$level" "$1")"
    echo "There are $count $level instances detected in this log file"
done

